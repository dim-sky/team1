# nginx fills in ${BACKEND_URL} from the environment when the container starts.
#   docker compose: http://backend:8000   (default set in the Dockerfile)
#   Azure:          http://team1-backend  (set in apps.bicep)
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Angular calls /api/post -> nginx forwards it to ${BACKEND_URL}/post
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_http_version 1.1;
        proxy_buffering off;        # pass streamed agent responses straight through
        proxy_read_timeout 300s;    # LLM answers can take a while
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Single Page Application: unknown paths load index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
